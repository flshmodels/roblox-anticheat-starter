local T = require("./framework")
local Limiter = require("../src/RateLimiter")
local Validation = require("../src/Validation")
T.describe("RateLimiter", function()
	T.test("limits a burst, refills and separates users", function()
		local now = 0
		local limit = Limiter.new(2, 1, function() return now end)
		T.eq(limit:allow(1), true)
		T.eq(limit:allow(1), true)
		T.eq(limit:allow(1), false)
		T.eq(limit:allow(2), true)
		now = 1
		T.eq(limit:allow(1), true)
		T.eq(limit:allow(1), false)
		limit:remove(1)
		T.eq(limit:allow(1), true)
	end)
	T.test("rejects invalid configuration", function()
		T.eq(pcall(function() Limiter.new(0, 1) end), false)
		T.eq(pcall(function() Limiter.new(1, math.huge) end), false)
	end)
end)
T.describe("Validation", function()
	T.test("rejects invalid numbers and strings", function()
		T.eq(Validation.numberInRange(5, 1, 10), true)
		T.eq(Validation.numberInRange(0/0, 1, 10), false)
		T.eq(Validation.numberInRange(math.huge, 1, 10), false)
		T.eq(Validation.numberInRange(11, 1, 10), false)
		T.eq(Validation.shortString("abc", 3), true)
		T.eq(Validation.shortString("abcd", 3), false)
		T.eq(Validation.shortString({}, 3), false)
	end)
end)
if not T.run() then error("tests failed") end
